{
  "description": "Nova context and skill routing.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh hooks/nova_context.sh session-start",
            "timeout": 5,
            "additionalContextLimit": 500,
            "statusMessage": "Loading Nova context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh hooks/nova_context.sh prompt-submit",
            "timeout": 5,
            "additionalContextLimit": 500,
            "statusMessage": "Routing through Nova skills"
          }
        ]
      }
    ]
  }
}
