#!/bin/sh

set -eu
umask 077
LC_ALL=C
export LC_ALL

program_name=nova-safety

say() {
  printf '%s\n' "$*"
}

warn() {
  printf '%s: %s\n' "$program_name" "$*" >&2
}

fail() {
  warn "$*"
  exit 1
}

repository_root() {
  git rev-parse --show-toplevel 2>/dev/null || fail "run this inside a Nova Git repository"
}

calculate_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
    return
  fi

  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
    return
  fi

  fail "sha256sum or shasum is required"
}

redact_remote_url() {
  printf '%s\n' "$1" | sed -E 's#(https?://)[^/@]+@#\1[REDACTED]@#'
}

scan_stream() {
  awk '
    function report(rule) {
      if (!seen[rule]) {
        print rule
        seen[rule] = 1
      }
      found = 1
    }

    {
      raw = $0
      lower = tolower(raw)

      if (raw ~ /-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----/) {
        report("private key")
      }
      if (raw ~ /AKIA[0-9A-Z]{16}/) {
        report("AWS access key")
      }
      if (raw ~ /(gh[pousr]_[A-Za-z0-9_]{30,}|github_pat_[A-Za-z0-9_]{20,})/) {
        report("GitHub token")
      }
      if (raw ~ /xox[baprs]-[A-Za-z0-9-]{10,}/) {
        report("Slack token")
      }
      if (raw ~ /sk-(proj-)?[A-Za-z0-9_-]{20,}/) {
        report("OpenAI token")
      }
      if (raw ~ /sk-ant-[A-Za-z0-9_-]{20,}/) {
        report("Anthropic token")
      }
      if (raw ~ /AIza[0-9A-Za-z_-]{30,}/) {
        report("Google API key")
      }
      if (raw ~ /[sr]k_live_[0-9A-Za-z]{16,}/) {
        report("Stripe live key")
      }
      if (raw ~ /npm_[A-Za-z0-9]{20,}/) {
        report("npm token")
      }
      if (raw ~ /hf_[A-Za-z0-9]{20,}/) {
        report("Hugging Face token")
      }
      if (raw ~ /eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}/) {
        report("JSON web token")
      }
      basic_auth_url = "https?" ":" "/" "/" "[^[:space:]\\/:@]+:[^[:space:]\\/@]+@"
      if (lower ~ basic_auth_url) {
        report("credential embedded in URL")
      }
      if (lower ~ /[?&](api[_-]?key|access[_-]?token|auth[_-]?token|token|key|secret|signature|sig)=[a-z0-9_\/.+=-]{12,}/) {
        report("credential embedded in URL query")
      }

      placeholder = lower ~ /(\[redacted\]|<redacted>|placeholder|example|sample|changeme|your[_-]|\$\{|\$[a-z_])/
      if (!placeholder && lower ~ /(^|[^a-z0-9_])(password|passwd|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)[[:space:]]*[:=]?[[:space:]]*["]?[a-z0-9_\/.+=-]{12,}/) {
        report("credential-like assignment")
      }
    }

    END {
      if (found) exit 7
    }
  '
}

normalize_scan_input() {
  input_path=$1
  output_path=$2
  if ! tr '\000' '\n' < "$input_path" > "$output_path"; then
    fail "could not normalize content for scanning"
  fi
}

is_sensitive_filename() {
  candidate=$1
  basename=${candidate##*/}
  normalized_basename=$(printf '%s' "$basename" | tr '[:upper:]' '[:lower:]')

  case "$normalized_basename" in
    .env.example|.env.sample|.env.template)
      return 1
      ;;
    .env|.env.*|.netrc|_netrc|auth.json|credentials.json|credentials.*.json|secrets.json|secrets.yaml|secrets.yml)
      return 0
      ;;
  esac

  case "$normalized_basename" in
    *.pem|*.p12|*.pfx|*.key|id_rsa|id_ed25519)
      return 0
      ;;
  esac

  return 1
}

create_temporary_directory() {
  if [ -n "${safety_temporary_directory:-}" ]; then
    return
  fi

  safety_temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/nova-safety.XXXXXX")
  trap 'rm -rf "$safety_temporary_directory"' EXIT HUP INT TERM
}

scan_staged_changes() {
  create_temporary_directory
  staged_paths=$safety_temporary_directory/staged-paths
  git diff --cached --name-only --diff-filter=ACMR -- . > "$staged_paths"
  blocked=false

  while IFS= read -r staged_path; do
    [ -n "$staged_path" ] || continue

    if is_sensitive_filename "$staged_path"; then
      warn "blocked sensitive filename: $staged_path"
      blocked=true
      continue
    fi

    staged_content=$safety_temporary_directory/staged-content
    normalized_staged_content=$safety_temporary_directory/normalized-staged-content
    if ! git show ":$staged_path" > "$staged_content" 2>/dev/null; then
      fail "could not read staged file: $staged_path"
    fi
    normalize_scan_input "$staged_content" "$normalized_staged_content"

    if findings=$(scan_stream < "$normalized_staged_content"); then
      :
    else
      scan_status=$?
      if [ "$scan_status" -eq 7 ]; then
        warn "blocked possible secret in: $staged_path"
        printf '%s\n' "$findings" | sed 's/^/  detected: /' >&2
        blocked=true
      else
        fail "could not scan staged file: $staged_path"
      fi
    fi
  done < "$staged_paths"

  if [ "$blocked" = true ]; then
    warn "commit stopped before sensitive data entered Git history"
    warn "replace the value with a placeholder or unstage the file, then retry"
    return 1
  fi
}

scan_reachable_objects() {
  revisions_file=$1
  positive_tips_file=${2:-$1}
  [ -s "$revisions_file" ] || return 0

  create_temporary_directory
  object_listing=$safety_temporary_directory/object-listing
  object_ids=$safety_temporary_directory/object-ids
  object_types=$safety_temporary_directory/object-types
  blob_ids=$safety_temporary_directory/blob-ids
  historical_paths=$safety_temporary_directory/history-paths
  tip_paths=$safety_temporary_directory/tip-paths
  blob_contents=$safety_temporary_directory/blob-contents
  normalized_blob_contents=$safety_temporary_directory/normalized-blob-contents

  : > "$historical_paths"

  if ! git rev-list --objects --no-object-names --stdin \
    < "$revisions_file" > "$object_listing"; then
    fail "could not enumerate Git objects"
  fi
  sed '/^$/d' "$object_listing" | sort -u > "$object_ids"

  if ! git -c core.quotePath=false log --stdin -m --name-only --format= -- \
    < "$revisions_file" > "$historical_paths"; then
    fail "could not enumerate paths in Git history"
  fi

  while IFS= read -r tip; do
    [ -n "$tip" ] || continue
    peeled_tip=$(git rev-parse "$tip^{}" 2>/dev/null) || \
      fail "could not resolve a Git tip"
    peeled_type=$(git cat-file -t "$peeled_tip" 2>/dev/null) || \
      fail "could not identify a Git tip"
    case "$peeled_type" in
      commit|blob)
        ;;
      tree)
        if ! git -c core.quotePath=false ls-tree -r --name-only "$peeled_tip" \
          > "$tip_paths"; then
          fail "could not enumerate paths in a Git tree"
        fi
        cat "$tip_paths" >> "$historical_paths"
        ;;
      *)
        fail "unsupported Git tip type: $peeled_type"
        ;;
    esac
  done < "$positive_tips_file"

  sort -u "$historical_paths" -o "$historical_paths"
  blocked=false

  while IFS= read -r historical_path; do
    [ -n "$historical_path" ] || continue
    case "$historical_path" in
      \"*\") fail "could not safely inspect a quoted Git path" ;;
    esac
    if is_sensitive_filename "$historical_path"; then
      warn "blocked sensitive filename in Git history: $historical_path"
      blocked=true
    fi
  done < "$historical_paths"

  if ! git cat-file --batch-check='%(objectname) %(objecttype)' \
    < "$object_ids" > "$object_types"; then
    fail "could not identify Git objects"
  fi
  if awk 'NF != 2 || $2 == "missing" { exit 1 }' "$object_types"; then
    :
  else
    fail "could not identify a Git object"
  fi
  awk '$2 == "blob" {print $1}' "$object_types" > "$blob_ids"

  if ! git cat-file --batch < "$blob_ids" > "$blob_contents"; then
    fail "could not read Git blobs"
  fi
  normalize_scan_input "$blob_contents" "$normalized_blob_contents"

  if findings=$(scan_stream < "$normalized_blob_contents"); then
    :
  else
    scan_status=$?
    if [ "$scan_status" -eq 7 ]; then
      warn "blocked possible secret retained in Git history"
      printf '%s\n' "$findings" | sed 's/^/  detected: /' >&2
      blocked=true
    else
      fail "could not scan Git blobs"
    fi
  fi

  if [ "$blocked" = true ]; then
    warn "push stopped before the repository left this machine"
    warn "removing a current line is not enough; the older commit must also be cleaned"
    return 1
  fi
}

collect_local_tips() {
  tips_file=$1
  : > "$tips_file"
  git for-each-ref --format='%(objectname)' refs/heads refs/tags refs/remotes \
    >> "$tips_file"
  git rev-parse --verify HEAD >> "$tips_file" 2>/dev/null || true
  sort -u "$tips_file" -o "$tips_file"
}

scan_git_history() {
  create_temporary_directory
  local_tips=$safety_temporary_directory/local-tips
  collect_local_tips "$local_tips"
  scan_reachable_objects "$local_tips"
}

validate_remote_name() {
  remote_name=$1
  case "$remote_name" in
    ''|*[!A-Za-z0-9._-]*) fail "unsupported remote name: $remote_name" ;;
  esac
}

is_zero_oid() {
  case "$1" in
    ''|*[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

remote_url_hash() {
  printf '%s' "$1" | calculate_sha256
}

remote_url_has_embedded_credentials() {
  printf '%s\n' "$1" | awk '
    {
      scheme_end = index($0, "://")
      if (!scheme_end) exit 1
      scheme = tolower(substr($0, 1, scheme_end - 1))
      authority = substr($0, scheme_end + 3)
      slash = index(authority, "/")
      if (slash) authority = substr(authority, 1, slash - 1)
      at = index(authority, "@")
      if (!at) exit 1
      userinfo = substr(authority, 1, at - 1)
      if (scheme == "ssh" && userinfo !~ /:/) exit 1
      if (scheme == "git" && userinfo !~ /:/) exit 1
      exit 0
    }
  '
}

github_slug_from_url() {
  remote_url=$1
  printf '%s\n' "$remote_url" | sed -n -E \
    -e 's#^https?://github\.com/([^/]+/[^/]+)$#\1#p' \
    -e 's#^git@github\.com:([^/]+/[^/]+)$#\1#p' \
    -e 's#^ssh://git@github\.com/([^/]+/[^/]+)$#\1#p' | \
    sed 's/\.git$//' | sed -n '1p'
}

verify_github_private_when_possible() {
  remote_url=$1
  github_slug=$(github_slug_from_url "$remote_url")
  [ -n "$github_slug" ] || return 2
  command -v gh >/dev/null 2>&1 || return 2

  if visibility=$(GH_HTTP_TIMEOUT=${GH_HTTP_TIMEOUT:-5} \
    gh repo view "$github_slug" --json visibility --jq '.visibility' 2>/dev/null); then
    case "$visibility" in
      PRIVATE)
        return 0
        ;;
      PUBLIC|INTERNAL)
        warn "remote visibility is $visibility; a working Nova must use a private repository"
        return 1
        ;;
    esac
  fi

  return 2
}

approval_key() {
  printf 'novaSafety.%s.approvedUrlHash' "$1"
}

approve_remote() {
  remote_name=${1:-origin}
  validate_remote_name "$remote_name"
  exec 3<&0
  create_temporary_directory
  push_urls=$safety_temporary_directory/push-urls
  if ! git remote get-url --push --all "$remote_name" > "$push_urls" 2>/dev/null; then
    fail "remote not found: $remote_name"
  fi
  [ -s "$push_urls" ] || fail "remote has no push URL: $remote_name"
  scan_git_history
  say "Nova backup safety review"

  while IFS= read -r remote_url; do
    [ -n "$remote_url" ] || fail "remote has an empty push URL: $remote_name"
    if remote_url_has_embedded_credentials "$remote_url"; then
      fail "remote URL contains embedded credentials"
    fi

    safe_remote_url=$(redact_remote_url "$remote_url")
    say "Remote: $remote_name ($safe_remote_url)"

    if verify_github_private_when_possible "$remote_url"; then
      say "Visibility: PRIVATE (verified with GitHub CLI)"
    else
      verification_status=$?
      [ "$verification_status" -ne 1 ] || return 1
      say "Nova could not verify this remote's visibility automatically."
      printf 'Type PRIVATE only after confirming that this destination is private: '
      IFS= read -r confirmation <&3 || fail "private repository confirmation is required"
      [ "$confirmation" = PRIVATE ] || fail "remote was not approved"
    fi
  done < "$push_urls"

  key=$(approval_key "$remote_name")
  git config --local --unset-all "$key" >/dev/null 2>&1 || true
  while IFS= read -r remote_url; do
    approved_hash=$(remote_url_hash "$remote_url")
    git config --local --add "$key" "$approved_hash"
  done < "$push_urls"
  say "Approved private backup remote: $remote_name"
}

remote_is_approved() {
  remote_name=$1
  remote_url=$2
  current_hash=$(remote_url_hash "$remote_url")
  git config --local --get-all "$(approval_key "$remote_name")" 2>/dev/null | \
    grep -Fx "$current_hash" >/dev/null
}

is_official_public_source() {
  remote_name=$1
  push_urls=$2
  outgoing_tips=$3
  [ "$remote_name" = origin ] || return 1

  while IFS= read -r public_source_url; do
    [ "$(github_slug_from_url "$public_source_url")" = thefactus/nova ] || \
      return 1
  done < "$push_urls"

  if [ ! -s "$outgoing_tips" ]; then
    [ "$(git show HEAD:.nova-public-source 2>/dev/null)" = \
      "Nova public source: https://github.com/thefactus/nova" ]
    return
  fi

  while IFS= read -r outgoing_tip; do
    [ -n "$outgoing_tip" ] || continue
    [ "$(git show "$outgoing_tip:.nova-public-source" 2>/dev/null)" = \
      "Nova public source: https://github.com/thefactus/nova" ] || return 1
  done < "$outgoing_tips"
}

enable_hooks() {
  root=$(repository_root)
  [ -x "$root/.githooks/pre-commit" ] || fail "Nova pre-commit hook is missing"
  [ -x "$root/.githooks/pre-push" ] || fail "Nova pre-push hook is missing"

  configured_hooks_path=$(git config --local --get core.hooksPath 2>/dev/null || true)
  case "$configured_hooks_path" in
    '')
      git config --local core.hooksPath .githooks
      say "Nova Git safety hooks enabled."
      ;;
    .githooks)
      say "Nova Git safety hooks are already enabled."
      ;;
    *)
      warn "existing core.hooksPath was preserved: $configured_hooks_path"
      warn "Nova safety hooks were not enabled; combine the hook directories manually"
      return 2
      ;;
  esac
}

pre_push() {
  remote_name=${1:-origin}
  remote_url=${2:-}
  case "$remote_name" in
    *://*|/*|*@*:*)
      fail "push by URL is not supported; configure and approve a named remote"
      ;;
  esac
  validate_remote_name "$remote_name"
  [ -n "$remote_url" ] || remote_url=$(git remote get-url "$remote_name" 2>/dev/null || true)
  [ -n "$remote_url" ] || fail "could not resolve remote: $remote_name"

  create_temporary_directory
  current_push_urls=$safety_temporary_directory/current-push-urls
  if ! git remote get-url --push --all "$remote_name" \
    > "$current_push_urls" 2>/dev/null; then
    fail "could not resolve push URLs for remote: $remote_name"
  fi
  [ -s "$current_push_urls" ] || \
    fail "remote has no push URL: $remote_name"
  outgoing_tips=$safety_temporary_directory/outgoing-tips
  outgoing_revisions=$safety_temporary_directory/outgoing-revisions
  : > "$outgoing_tips"
  : > "$outgoing_revisions"
  while IFS=' ' read -r local_ref local_oid remote_ref remote_oid extra; do
    [ -n "$local_ref$local_oid$remote_ref$remote_oid$extra" ] || continue
    [ -z "$extra" ] || fail "could not parse the pre-push update list"
    [ -n "$local_ref" ] && [ -n "$local_oid" ] && \
      [ -n "$remote_ref" ] && [ -n "$remote_oid" ] || \
      fail "could not parse the pre-push update list"
    case "$local_oid" in
      *[!0-9a-fA-F]*) fail "pre-push supplied an invalid object ID" ;;
    esac
    case "$remote_oid" in
      *[!0-9a-fA-F]*) fail "pre-push supplied an invalid remote object ID" ;;
    esac
    if ! is_zero_oid "$local_oid"; then
      printf '%s\n' "$local_oid" >> "$outgoing_tips"
      printf '%s\n' "$local_oid" >> "$outgoing_revisions"
      if ! is_zero_oid "$remote_oid" && \
         git cat-file -e "$remote_oid" 2>/dev/null; then
        printf '^%s\n' "$remote_oid" >> "$outgoing_revisions"
      fi
    fi
  done
  sort -u "$outgoing_tips" -o "$outgoing_tips"
  sort -u "$outgoing_revisions" -o "$outgoing_revisions"
  scan_reachable_objects "$outgoing_revisions" "$outgoing_tips"

  if is_official_public_source "$remote_name" "$current_push_urls" "$outgoing_tips"; then
    return 0
  fi

  all_push_urls_approved=true
  while IFS= read -r current_push_url; do
    if ! remote_is_approved "$remote_name" "$current_push_url"; then
      all_push_urls_approved=false
    fi
  done < "$current_push_urls"

  if [ "$all_push_urls_approved" = false ] || \
     ! remote_is_approved "$remote_name" "$remote_url"; then
    safe_remote_url=$(redact_remote_url "$remote_url")
    warn "push blocked because this backup remote has not been approved"
    warn "remote: $remote_name ($safe_remote_url)"
    warn "run: sh bin/nova-safety approve $remote_name"
    return 1
  fi

}

usage() {
  cat <<'EOF'
Usage: sh bin/nova-safety COMMAND [REMOTE]

Commands:
  enable                 Enable Nova's Git hooks when no custom hook path exists
  check                  Scan staged files and all local Git history
  approve [remote]       Review and approve a private backup remote
  pre-commit             Run the automatic staged-content check
  pre-push remote url    Run the automatic history and remote check
EOF
}

root=$(repository_root)
cd "$root"

case "${1:-}" in
  enable)
    enable_hooks
    ;;
  check)
    scan_staged_changes
    scan_git_history
    say "Nova safety check passed."
    ;;
  approve)
    approve_remote "${2:-origin}"
    ;;
  pre-commit)
    scan_staged_changes
    ;;
  pre-push)
    pre_push "${2:-origin}" "${3:-}"
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
